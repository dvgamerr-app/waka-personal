{
  "name": "waka-personal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun x --bun astro dev",
    "build:dist": "bun x --bun astro build",
    "preview": "bun x --bun astro preview",
    "lint": "bun x --bun prettier --check .",
    "check": "bun run lint && bun run build:dist",
    "format": "bun x --bun prettier --write .",
    "prepare": "bun x --bun husky"
  },
  "dependencies": {
    "@astrojs/react": "6.0.3",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@nurodev/astro-bun": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.32.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "lint-staged": {
    "*.{js,jsx,astro,css,md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
