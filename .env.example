# Required: the key WakaTime plugins send. Leaving it empty disables auth.
# Generate one with: openssl rand -hex 24
APP_API_KEY=REPLACE_ME

# Required for docker compose: password of the bundled PostgreSQL.
POSTGRES_PASSWORD=REPLACE_ME

# Optional
# APP_TIMEZONE=Asia/Bangkok
# PORT=8080
# IMAGE_TAG=latest
# LOG_LEVEL=info
# POSTGRES_DB=waka_personal
# POSTGRES_PORT=5432

# Local development with `go run ./cmd` against `docker compose up -d postgres`.
# Keep the password in sync with POSTGRES_PASSWORD above.
# DATABASE_URL=postgres://postgres:REPLACE_ME@localhost:5432/waka_personal?sslmode=disable
