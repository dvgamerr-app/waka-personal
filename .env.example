# Required: the key WakaTime plugins send. docker compose refuses to start while it is empty.
# Generate one with: openssl rand -hex 24
APP_API_KEY=

# Required for docker compose: password of the bundled PostgreSQL. It is placed in DATABASE_URL
# unescaped, so use hex or alphanumeric characters only (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Optional
# APP_TIMEZONE=Asia/Bangkok
# PORT=8080
# IMAGE_TAG=latest
# LOG_LEVEL=info
# POSTGRES_DB=waka_personal
# POSTGRES_PORT=5432

# Local development with `go run ./cmd` against `docker compose up -d postgres`.
# Keep the password in sync with POSTGRES_PASSWORD above.
# DATABASE_URL=postgres://postgres:REPLACE_ME@localhost:5432/waka_personal?sslmode=disable
