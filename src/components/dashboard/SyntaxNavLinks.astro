---
const { active = 'dashboard' } = Astro.props

const links = [
  { id: 'dashboard', href: '/', label: 'Dashboard' },
  { id: 'insights', href: '/insights', label: 'Insights' },
  { id: 'wrapped', href: '/wrapped', label: 'Wrapped' },
]
---

{
  links.map((link) => (
    <a
      href={link.href}
      class={active === link.id ? 'text-sky-300' : 'transition-colors hover:text-zinc-300'}
      aria-current={active === link.id ? 'page' : undefined}
    >
      {link.label}
    </a>
  ))
}
