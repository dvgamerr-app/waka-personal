---
const {
  active = 'dashboard',
  command = 'activity_overview',
  subtitle = '',
  meta = [] as string[],
} = Astro.props

const links = [
  { id: 'dashboard', href: '/', label: 'Dashboard' },
  { id: 'insights', href: '/insights', label: 'Insights' },
  { id: 'wrapped', href: '/wrapped', label: 'Wrapped' },
]
---

<div
  class="min-h-screen bg-zinc-950 font-mono text-zinc-300 selection:bg-sky-300/30 selection:text-white"
>
  <nav class="sticky top-0 z-50 border-b border-zinc-900 bg-zinc-950/85 backdrop-blur-sm">
    <div class="md:hidden flex gap-5 border-b border-zinc-900/50 px-4 py-1.5 text-[11px] tracking-[0.24em] text-zinc-600 uppercase">
      {links.map((link) => (
        <a
          href={link.href}
          class={active === link.id ? 'text-sky-300' : 'transition-colors hover:text-zinc-300'}
          aria-current={active === link.id ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="mx-auto flex h-12 max-w-[1600px] items-center justify-between gap-4 px-4">
      <div class="flex min-w-0 items-center gap-6">
        <a href="/" class="flex items-center gap-2">
          <span class="h-2 w-2 animate-pulse bg-sky-300"></span>
          <span class="text-sm font-semibold tracking-tight text-zinc-100">WAKA_PERSONAL v2</span>
        </a>
        <div
          class="hidden items-center gap-4 text-xs tracking-[0.24em] text-zinc-600 uppercase md:flex"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class={
                  active === link.id ? 'text-sky-300' : 'transition-colors hover:text-zinc-300'
                }
                aria-current={active === link.id ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
      <slot name="nav-right" />
    </div>
  </nav>

  <main class="mx-auto max-w-[1600px] p-4 md:p-6 lg:p-8">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-2xl font-medium tracking-tight text-zinc-100 md:text-3xl">
          <span class="text-sky-300">$</span>
          {command}
          <span class="ml-2 inline-block h-5 w-2 animate-pulse bg-sky-300 align-middle"></span>
        </h1>
        {
          subtitle && (
            <p class="mt-1 text-xs tracking-[0.22em] text-zinc-500 uppercase">{subtitle}</p>
          )
        }
      </div>
      <div id="shell-meta" class="text-right text-[11px] tracking-[0.22em] text-zinc-600 uppercase">
        {meta.map((item) => <div>{item}</div>)}
      </div>
    </header>

    <slot />

    <footer
      class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-2 border border-zinc-900 bg-zinc-950 p-4 text-[11px] text-zinc-600"
    >
      <div class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 bg-zinc-500"></span>
        <span class="text-zinc-500 uppercase">Route Status:</span>
        <span class="text-zinc-300 uppercase">Static</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-zinc-500 uppercase">Routes:</span>
        <span class="text-zinc-300">Dashboard / Insights / Wrapped</span>
      </div>
      <div class="ml-auto flex gap-4">
        <span>API</span>
        <span>CONFIG</span>
        <span class="text-zinc-800">-</span>
        <span>TRI_VIEW</span>
      </div>
    </footer>
  </main>
</div>
