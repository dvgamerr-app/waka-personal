---
import Layout from '@/layouts/Layout.astro'
import SyntaxShell from '@/components/dashboard/SyntaxShell.astro'
import WrappedView from '@/components/dashboard/Wrapped'
import YearPicker from '@/components/dashboard/YearPicker'

const year = new Date().getFullYear()
const dashboardConfig = {
  apiBase: (import.meta.env.PUBLIC_API_BASE || '').replace(/\/$/, ''),
  timezone: import.meta.env.PUBLIC_APP_TIMEZONE || import.meta.env.APP_TIMEZONE || 'UTC',
}
---

<Layout title={`Waka Personal Wrapped ${year}`}>
  <SyntaxShell
    active="wrapped"
    command={`wrapped --year=${year}`}
    subtitle={`Annual Telemetry Compilation · ${year} Year-in-Code Report`}
    meta={[`Timezone: ${dashboardConfig.timezone}`]}
  >
    <YearPicker client:load slot="nav-right" />
    <WrappedView client:load config={dashboardConfig} year={year} />
  </SyntaxShell>
</Layout>
