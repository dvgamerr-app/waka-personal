---
import Layout from '@/layouts/Layout.astro'
import SyntaxShell from '@/components/dashboard/SyntaxShell.astro'
import WrappedView from '@/components/dashboard/Wrapped'
import YearPicker from '@/components/dashboard/YearPicker'
import { dashboardConfig } from '@/lib/dashboardConfig.js'
---

<Layout title="Waka Personal Wrapped">
  <SyntaxShell
    active="wrapped"
    command="wrapped --year=2XXX"
    subtitle="Annual Telemetry Compilation · 2XXX Year-in-Code Report"
    meta={[`Timezone: ${dashboardConfig.timezone}`]}
  >
    <YearPicker client:load slot="nav-right" />
    <WrappedView client:load config={dashboardConfig} />
  </SyntaxShell>
</Layout>
