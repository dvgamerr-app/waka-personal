---
import Layout from '@/layouts/Layout.astro'
import SyntaxShell from '@/components/dashboard/SyntaxShell.astro'
import Insights from '@/components/dashboard/Insights'
import { dashboardConfig } from '@/lib/dashboardConfig.js'
---

<Layout title="Waka Personal Insights">
  <SyntaxShell
    active="insights"
    command="insights --window=last-week"
    subtitle="Pattern Analysis · Behavioral Telemetry · Anomaly Surface"
  >
    <Insights client:load config={dashboardConfig} />
  </SyntaxShell>
</Layout>
