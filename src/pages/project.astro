---
import Layout from '@/layouts/Layout.astro'
import SyntaxShell from '@/components/dashboard/SyntaxShell.astro'
import ProjectDetail from '@/components/dashboard/ProjectDetail'
import { dashboardConfig } from '@/lib/dashboardConfig.js'
---

<Layout title="Project Detail · Waka Personal">
  <SyntaxShell
    command="project --inspect"
    subtitle="Project Telemetry · Activity Trend · Environment Breakdown"
  >
    <ProjectDetail client:load config={dashboardConfig} />
  </SyntaxShell>
</Layout>
